FLASK_SECRET_KEY=change-me-in-production
FLASK_ENV=development

# Origines autorisées pour le front React (séparées par des virgules)
# CORS_ORIGINS=http://localhost:5173,https://nano-orbite.tlugagne.live

# Cookies de session cross-origin (front localhost → API HTTPS)
SESSION_COOKIE_SAMESITE=None
SESSION_COOKIE_SECURE=true

