FLASK_SECRET_KEY=change-me-in-production
FLASK_ENV=development

# URL exacte du front déployé (schéma + domaine, sans slash final)
FRONTEND_ORIGIN=https://nano-orbite-prod.tlugagne.live

# Ou liste complète (remplace les valeurs par défaut) :
CORS_ORIGINS=http://localhost:5173,https://nano-orbite-prod.tlugagne.live,https://tlugagne.alwaysdata.net


# Cookies de session cross-origin (front localhost → API HTTPS)
SESSION_COOKIE_SAMESITE=None
SESSION_COOKIE_SECURE=true

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=nanoOrbit_db
MYSQL_USER=root
MYSQL_PASSWORD=
